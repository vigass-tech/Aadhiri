{
  "name": "aadhirai-smart-citizen-complaint-management",
  "version": "1.0.0",
  "description": "AADHIRAI – Smart Citizen Complaint Management System (MERN Stack)",
  "main": "server/src/server.js",
  "scripts": {
    "build": "npm --prefix client install && npm --prefix client run build",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "seed": "npm --prefix server run seed"
  },
  "keywords": [
    "mern",
    "complaint-management",
    "citizen-portal",
    "government",
    "react",
    "express",
    "mongodb"
  ],
  "author": "Aadhirai Team",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
