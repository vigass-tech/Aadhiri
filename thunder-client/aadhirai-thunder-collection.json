        "raw": "{\n  \"departmentId\": \"{{DEPARTMENT_ID}}\",\n  \"reviewerId\": \"{{REVIEWER_ID}}\",\n  \"priority\": \"HIGH\",\n  \"remarks\": \"Assigned to field inspector for urgent site evaluation.\"\n}"
      }
    },
    {
